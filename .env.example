# ==============================================================================
# CAMPAIGN MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development:
# cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# OPTION A: Local MySQL (Default / Standalone MySQL 8.0)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campaign_management
DB_SSL=false

# ------------------------------------------------------------------------------
# OPTION B: TiDB Cloud Serverless (Production / Render)
# Obtain these values from your TiDB Cloud Console -> Connect -> General
# ------------------------------------------------------------------------------
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxx.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=campaign_management
# DB_SSL=true

# ------------------------------------------------------------------------------
# Connection Pool & Security Settings
# ------------------------------------------------------------------------------
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace_with_a_long_random_secret_in_production
TRUST_PROXY=false
